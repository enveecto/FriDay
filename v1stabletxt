# 🗄️ PERSISTENCE & MEMORY
# =========================
class FridayMemory:
    def __init__(self):
        self.db_path = "friday_core.db"
        self._init_db()

    def _init_db(self):
        with sqlite3.connect(self.db_path) as conn:
            conn.execute("CREATE TABLE IF NOT EXISTS events (id INTEGER PRIMARY KEY, time TEXT, task TEXT, status TEXT)")
            conn.execute("CREATE TABLE IF NOT EXISTS settings (key TEXT PRIMARY KEY, value TEXT)")
    
    def add_event(self, time_str, task):
        with sqlite3.connect(self.db_path) as conn:
            conn.execute("INSERT INTO events (time, task, status) VALUES (?, ?, 'pending')", (time_str, task))

    def get_due_events(self):
        now = datetime.now().strftime("%Y-%m-%d %H:%M")
        with sqlite3.connect(self.db_path) as conn:
            cursor = conn.execute("SELECT id, task FROM events WHERE time <= ? AND status = 'pending'", (now,))
            return cursor.fetchall()

    def mark_event_done(self, event_id):
        with sqlite3.connect(self.db_path) as conn:
            conn.execute("UPDATE events SET status = 'completed' WHERE id = ?", (event_id,))

# =========================
# ⚙️ TASK EXECUTOR
# =========================
class TaskExecutor:
    @staticmethod
    def execute(tasks):
        results = []
        for task in tasks:
            action = task.get("action")
            value = task.get("value")
            try:
                if action == "open_url": webbrowser.open(value)
                elif action == "launch": subprocess.Popen(value, shell=True)
                elif action == "type": pyautogui.write(value)
                elif action == "press": pyautogui.press(value)
                elif action == "sys_cmd": os.system(value)
                results.append(f"Executed {action}")
            except Exception as e:
                results.append(f"Error in {action}: {str(e)}")
        return results

