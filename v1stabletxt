    async def process_query(self, text):
        now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        prompt = f"""
        System: You are F.R.I.D.A.Y., a highly advanced, professional American AI assistant. 
        Current Time: {now}
        User Intent: {text}

        Rules for Extreme Speed:
        1. Keep your verbal replies UNDER 15 WORDS. Be ruthlessly brief, direct, and snappy.
        2. Do not use conversational filler. Provide the answer or confirm the action immediately.
        3. Speak in a natural American tone.

        Capabilities:
        - open_url: Open websites.
        - launch: Start local apps (e.g., 'notepad', 'calc').
        - type: Write text via keyboard.
        - schedule: Add event (value format: 'YYYY-MM-DD HH:MM | Task Description').
        - sys_cmd: Execute shell commands.

        Output ONLY JSON:
        {{
            "reply": "Extremely brief confirmation",
            "tasks": [{{"action": "capability", "value": "data"}}]
        }}
        """
        try:
            # Now runs asynchronously, preventing the UI from freezing!
            res = await self.client.chat.completions.create(
                model="meta-llama/llama-3-8b-instruct",
                messages=[{"role": "user", "content": prompt}],
                response_format={"type": "json_object"}
            )
            data = json.loads(res.choices[0].message.content)
            
            for t in data.get("tasks", []):
                if t['action'] == "schedule":
                    time_part, task_part = t['value'].split('|')
                    self.memory.add_event(time_part.strip(), task_part.strip())
            
            return data
        except Exception as e:
            return {"reply": f"System error: {str(e)}", "tasks": []}

