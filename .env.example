# Copy this file to .env and add exactly one provider key. Never commit .env.

# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-4o-mini

# Or use an OpenAI-compatible provider such as OpenRouter.
# OPENROUTER_API_KEY=your_openrouter_api_key
# OPENROUTER_MODEL=provider/model-name
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Optional: choose a microphone by the SpeechRecognition device index.
# MIC_DEVICE_INDEX=0
