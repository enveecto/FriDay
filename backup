async def main_loop(ui):
    import speech_recognition as sr
    pygame.mixer.init()
    rec = sr.Recognizer()
    mic = sr.Microphone()

    rec.pause_threshold = 0.8  
    rec.non_speaking_duration = 0.4
    rec.dynamic_energy_threshold = True 

    async def speak(text):
        ui.current_state = "speaking" 
        
        for p in ['. ', '? ', '! ', '.\n', '?\n', '!\n']:
            text = text.replace(p, p.strip() + '|SPLIT|')
        chunks = [c.strip() for c in text.split('|SPLIT|') if c.strip()]
        
        if not chunks: 
            ui.current_state = "idle"
            return

        audio_queue = asyncio.Queue()
        generated_files = []

        async def tts_generator():
            for chunk in chunks:
                path = os.path.join(tempfile.gettempdir(), f"fri_{uuid.uuid4()}.mp3")
                try:
                    await edge_tts.Communicate(chunk, "en-US-AriaNeural", rate="+15%").save(path)
                    generated_files.append(path)
                    await audio_queue.put((path, chunk)) 
                except Exception as e:
                    ui.log(f"❌ TTS Error: {e}")
            await audio_queue.put((None, None))

        asyncio.create_task(tts_generator())

        try:
            while True:
                if not pygame.mixer.music.get_busy():
                    path, chunk_text = await audio_queue.get()
                    if path is None: break 
                        
                    ui.log(f"🗣️ FRIDAY: {chunk_text}") 
                    pygame.mixer.music.load(path)
                    pygame.mixer.music.play()
                
                await asyncio.sleep(0.05) 
        finally:
            ui.current_state = "idle"
            pygame.mixer.music.unload() 
            for f in generated_files:
                try: os.remove(f)
                except: pass

    ui.current_state = "speaking"
    ui.log("✅ Core systems initialized. Hardware bridges online.")
    await speak("System initialized. Media controls and data projection online.")

    while True:
        due = ui.core.memory.get_due_events()
        for event_id, task in due:
            ui.log(f"⏰ Triggering Reminder: {task}")
            await speak(f"Reminder: {task}")
            ui.core.memory.mark_event_done(event_id)

        with mic as source:
            rec.adjust_for_ambient_noise(source, duration=0.2) 
            try:
                audio = rec.listen(source, timeout=1.5, phrase_time_limit=15)
                ui.current_state = "processing" 
                
                query = await asyncio.to_thread(rec.recognize_google, audio)
                query = query.lower()
                
                if "friday" in query:
                    ui.log(f"🎙️ USER: {query}")
                    
                    # Pass the UI log function deep into the core process so it can report back
                    data = await ui.core.process_query(query, ui.log)
                    
                    if data.get("info_panel"):
                        ui.update_readout(data["info_panel"])
                    
                    # Execute tasks and pass the logger so we see step-by-step telemetry
                    TaskExecutor.execute(data.get('tasks', []), ui.log)
                    
                    if data.get('reply'):
                        await speak(data['reply'])
                else:
                    ui.current_state = "idle"
                    
            except sr.WaitTimeoutError: ui.current_state = "idle"
            except sr.UnknownValueError: ui.current_state = "idle"
            except Exception as e:
                ui.log(f"❌ SYSTEM WARNING: {e}")
                ui.current_state = "idle"
        
        await asyncio.sleep(0.05)

if __name__ == "__main__":
    app = FridayHUD()
    threading.Thread(target=lambda: asyncio.run(main_loop(app)), daemon=True).start()
    app.mainloop()