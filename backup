        btn.pack(fill="x", padx=15, pady=6)

    def _update_graphs(self):
        self.graph_canvas.delete("graph")
        w, h = 286, 120 
        
        cpu_coords = []
        for i, val in enumerate(self.cpu_history):
            x = i * (w / 40)
            y = h - (val / 100 * h)
            cpu_coords.extend([x, y])
        if len(cpu_coords) >= 4:
            self.graph_canvas.create_line(cpu_coords, fill="#00D4FF", width=2, tags="graph", smooth=True)

        ram_coords = []
        for i, val in enumerate(self.ram_history):
            x = i * (w / 40)
            y = h - (val / 100 * h)
            ram_coords.extend([x, y])
        if len(ram_coords) >= 4:
            self.graph_canvas.create_line(ram_coords, fill="#FF8C00", width=2, tags="graph", smooth=True)

    def _animate(self):
        color = self.theme[self.current_state]
        self.frame_count += 1
        
        self.terminal.configure(text_color=color, border_color=color)
        self.title_vitals.configure(text_color=color)
        self.title_links.configure(text_color=color)
        self.title_info.configure(text_color=color)
        self.info_box.configure(text_color=color)
        
        if self.frame_count % 10 == 0:
            self.cpu_history.append(psutil.cpu_percent())
            self.ram_history.append(psutil.virtual_memory().percent)
            self._update_graphs()

            current_net_io = psutil.net_io_counters()
            current_time = time.time()
            dt = current_time - self.last_net_time
            if dt > 0:
                dl_speed = (current_net_io.bytes_recv - self.last_net_io.bytes_recv) / dt / 1024 / 1024
                ul_speed = (current_net_io.bytes_sent - self.last_net_io.bytes_sent) / dt / 1024 / 1024
                
                self.last_net_io = current_net_io
                self.last_net_time = current_time

                self.cpu_label.configure(text=f"CPU LOAD:  {self.cpu_history[-1]}%", text_color=color)
                self.ram_label.configure(text=f"MEMORY:  {self.ram_history[-1]}%", text_color=color)
                self.net_dl_label.configure(text=f"NET DOWN:  {dl_speed:.2f} MB/s", text_color=color)
                self.net_ul_label.configure(text=f"NET UP:  {ul_speed:.2f} MB/s", text_color=color)

        self.canvas.delete("wave")
        t = time.time()
        
        win_w = self.winfo_width()
        win_h = self.winfo_height()
        cx = win_w // 2 if win_w > 400 else 600 
        cy = (win_h // 2) - 100 if win_h > 200 else 300
        
        self.center_text.place(x=cx, y=cy - 120, anchor="center")

        if self.current_state == "idle":
            self.center_text.configure(text="AWAITING INPUT", text_color=color)
            amps, freq, speed = [20, 15, 10], 0.02, 3
        elif self.current_state == "processing":
            self.center_text.configure(text="PROCESSING...", text_color=color)
            amps, freq, speed = [60, 45, 30], 0.05, 15
        elif self.current_state == "speaking":
            self.center_text.configure(text="VOCALIZING...", text_color=color)
            amps, freq, speed = [120, 90, 60], 0.03, 10

        for i, amp in enumerate(amps):
            points = []
            for x in range(int(cx - 180), int(cx + 180), 10):
                y = cy + amp * math.sin(freq * (x - cx) + (t * speed) + i)
                taper_factor = max(0, 1 - abs(x - cx) / 180)
                y = cy + (y - cy) * taper_factor
                points.extend([x, y])
            
            if len(points) >= 4:
                self.canvas.create_line(points, fill=color, width=3-i, tags="wave", smooth=True)

        self.after(30, self._animate) 

    def log(self, msg):
        # We append to the terminal and automatically scroll to the bottom
        self.terminal.insert("end", f"[{datetime.now().strftime('%H:%M:%S')}] {msg}\n")
        self.terminal.see("end")

