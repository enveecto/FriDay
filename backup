# ⚙️ TASK EXECUTOR (WITH LOGGING)
# =========================
class TaskExecutor:
    @staticmethod
    def execute(tasks, logger):
        if not tasks:
            return
            
        for task in tasks:
            action = task.get("action")
            value = task.get("value")
            logger(f"⚙️ EXECUTING TASK: [{action}] -> {value}")
            try:
                if action == "open_url": 
                    webbrowser.open(value)
                elif action == "launch": 
                    subprocess.Popen(value, shell=True)
                elif action == "type": 
                    pyautogui.write(value)
                elif action == "press": 
                    pyautogui.press(value)
                elif action == "sys_cmd": 
                    os.system(value)
                
                # 📍 Google Maps Navigation
                elif action == "get_directions":
                    parts = value.split('|')
                    if len(parts) == 3:
                        origin, dest, mode = [p.strip() for p in parts]
                        safe_origin = urllib.parse.quote(origin)
                        safe_dest = urllib.parse.quote(dest)
                        safe_mode = urllib.parse.quote(mode.lower())
                        
                        if safe_mode not in ['driving', 'bicycling', 'walking', 'transit']:
                            safe_mode = 'driving'
                            
                        maps_url = f"https://www.google.com/maps/dir/?api=1&origin={safe_origin}&destination={safe_dest}&travelmode={safe_mode}"
                        webbrowser.open(maps_url)
                    else:
                        raise ValueError("Invalid format. Expected: Origin | Destination | Mode")
                
                # 📅 Create Google Calendar Event
                elif action == "gcal_create":
                    parts = value.split('|')
                    if len(parts) == 3:
                        time_str, duration, title = [p.strip() for p in parts]
                        link = gcal.create_event(time_str, duration, title)
                        logger(f"✅ EVENT CREATED: {link}")
                    else:
                        raise ValueError("Invalid format. Expected: YYYY-MM-DDTHH:MM:SS | Duration | Title")

                elif action == "play_youtube":
                    query = urllib.parse.quote(value)
                    url = f"https://www.youtube.com/results?search_query={query}"
                    html = urllib.request.urlopen(url)
                    video_ids = re.findall(r"watch\?v=(\S{11})", html.read().decode())
                    if video_ids:
                        webbrowser.open(f"https://www.youtube.com/watch?v={video_ids[0]}")
                    else:
                        raise Exception("Could not find video on YouTube.")

                elif action == "media_control":
                    if os.name == 'nt': 
                        key_map = {
                            "play_pause": 0xB3, "next": 0xB0, "prev": 0xB1, 
                            "mute": 0xAD, "vol_down": 0xAE, "vol_up": 0xAF      
                        }
                        if value in key_map:
                            vk = key_map[value]
                            presses = 5 if "vol" in value else 1
                            for _ in range(presses):
                                ctypes.windll.user32.keybd_event(vk, 0, 0, 0)
                                ctypes.windll.user32.keybd_event(vk, 0, 2, 0)
                    else:
                        if value == "play_pause": pyautogui.press("playpause")
                        elif value == "next": pyautogui.press("nexttrack")
                        elif value == "prev": pyautogui.press("prevtrack")
                        elif value == "vol_up": pyautogui.press("volumeup", presses=5)
                        elif value == "vol_down": pyautogui.press("volumedown", presses=5)
                        elif value == "mute": pyautogui.press("volumemute")
                else:
                    logger(f"⚠️ WARNING: Unknown action '{action}' requested by AI.")

                logger(f"✅ TASK SUCCESS: {action}")
            except Exception as e:
                logger(f"❌ TASK ERROR [{action}]: {str(e)}")

